# Yerel Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_K=20
OLLAMA_TOP_P=0.95
OLLAMA_PULL_TIMEOUT_SECONDS=3600
# Yalnızca kimlik doğrulayan uzak bir Ollama geçidi kullanılıyorsa:
# OLLAMA_API_KEY=

# Harici veri kaynaklarının ağ toleransı ve haber önbelleği
CYBER_API_CONNECT_TIMEOUT=20
CYBER_API_READ_TIMEOUT=60
GDELT_CONNECT_TIMEOUT=30
GDELT_READ_TIMEOUT=75
CYBER_NEWS_CACHE_SECONDS=300

# İsteğe bağlı veri kaynakları
# NEWSAPI_KEY=
# NVD_API_KEY=
# OTX_API_KEY=
# MISP_BASE_URL=https://misp.example.org
# MISP_API_KEY=
# MISP_VERIFY_TLS=true
